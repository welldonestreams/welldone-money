{
  "name": "welldone-money",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "WellDone Money \u2014 personal finance desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test",
    "dist": "npm run icons && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.welldonestreams.welldonemoney",
    "productName": "WellDone Money",
    "files": [
      "electron/**",
      "scripts/renewals-store.mjs",
      "index.html",
      "src/**",
      "assets/**",
      "auth.css",
      "styles.css",
      "sw.js",
      "manifest.webmanifest"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "WellDone Money",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "WellDone Money"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "artifactName": "WellDone-Money-Setup-${version}.${ext}"
  }
}
